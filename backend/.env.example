# Environment
NODE_ENV=development
PORT=4000

# Database (local Postgres — override locally with your real credentials)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/marketplace_dev?schema=public"

# JWT (REPLACE WITH A LONG RANDOM SECRET IN YOUR LOCAL .env — minimum 32 chars)
JWT_SECRET="please-replace-this-with-a-cryptographically-strong-secret"
JWT_EXPIRES_IN=7d

# Frontend (comma-separated list for multiple origins)
FRONTEND_URL=http://localhost:3000

# Security
BCRYPT_ROUNDS=10
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_AUTH_WINDOW_MS=900000

# Logging
LOG_LEVEL=info

# Mail (Mailtrap — fill in Phase 4 when wiring the queue processor)
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASS=
MAIL_FROM="Marketplace <no-reply@marketplace.local>"

# Seed admin (used by Phase 6 seed script)
SEED_ADMIN_EMAIL=admin@marketplace.local
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME="Platform Admin"
